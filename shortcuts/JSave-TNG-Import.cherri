#include 'actions/images'
#include 'actions/web'
#define name JSave TNG Import
#define color blue
#define inputs image
#define from sharesheet
#define noinput askfor image
#question shortcutKey "粘贴 JSave 设置页生成的快捷指令密钥" ""

const key = text(shortcutKey)
@keyText = "{key}"
if @keyText == "" {
    alert("请先在 JSave 设置页生成密钥，并在快捷指令的第一个「文本」操作填入密钥。未保存交易。", "JSave")
    stop()
}
const ocr = extractImageText(ShortcutInput)

@preview = jsonRequest("https://us-central1-jee-production.cloudfunctions.net/jsaveShortcutImport", "POST", {"action":"preview", "text":"{ocr}"}, {"Authorization":"Bearer {key}"})
@previewDict = getDictionary(@preview)
@apiErrorValue = getValue(@previewDict, "error")
@apiError = "{@apiErrorValue}"
if @apiError == "unauthorized" {
    alert("JSave 密钥无效或已停用。请在 JSave 设置页重新生成，并填入快捷指令的第一个「文本」操作。未保存交易。", "JSave")
    stop()
}
if @apiError != "" {
    alert("截图暂时无法识别（{@apiError}）。请检查是否为 TNG 成功交易详情页。未保存交易。", "JSave")
    stop()
}
@draftValue = getValue(@previewDict, "draft")
@draft = getDictionary(@draftValue)
@typeValue = getValue(@draft, "type")
@type = "{@typeValue}"
@amountValue = getValue(@draft, "amount")
@amount = "{@amountValue}"
@dateValue = getValue(@draft, "date")
@date = "{@dateValue}"
@timeValue = getValue(@draft, "time")
@time = "{@timeValue}"
@noteValue = getValue(@draft, "note")
@note = "{@noteValue}"
@category = ""
@categoryLabel = ""
@direction = ""
if @type == "expense" {
    @direction = "支出"
    menu "选择支出类别" {
        item "餐饮":
            @category = "catFood"
            @categoryLabel = "餐饮"
        item "交通":
            @category = "catTransport"
            @categoryLabel = "交通"
        item "账单":
            @category = "catBills"
            @categoryLabel = "账单"
        item "娱乐":
            @category = "catEntertainment"
            @categoryLabel = "娱乐"
        item "医疗":
            @category = "catHealth"
            @categoryLabel = "医疗"
        item "购物":
            @category = "catShopping"
            @categoryLabel = "购物"
        item "其他支出":
            @category = "catOther"
            @categoryLabel = "其他支出"
    }
} else {
    if @type == "income" {
        @direction = "收入"
        menu "选择收入类别" {
            item "薪资":
                @category = "catSalary"
                @categoryLabel = "薪资"
            item "接案":
                @category = "catFreelance"
                @categoryLabel = "接案"
            item "投资":
                @category = "catInvestment"
                @categoryLabel = "投资"
            item "礼物":
                @category = "catGift"
                @categoryLabel = "礼物"
            item "其他收入":
                @category = "catOtherIncome"
                @categoryLabel = "其他收入"
        }
    } else {
        alert("无法读取交易类型（{@type}），未保存交易。请确认已安装最新版快捷指令。", "JSave")
        stop()
    }
}

confirm("{@direction} RM{@amount}\n日期：{@date} {@time}\n对象：{@note}\n类别：{@categoryLabel}\n\n确认加入 JSave？", "核对 TNG 交易")
@commit = jsonRequest("https://us-central1-jee-production.cloudfunctions.net/jsaveShortcutImport", "POST", {"action":"commit", "text":"{ocr}", "category":"{@category}"}, {"Authorization":"Bearer {key}"})
@commitDict = getDictionary(@commit)
@statusValue = getValue(@commitDict, "status")
@status = "{@statusValue}"
if @status == "created" {
    alert("已加入 JSave。", "完成")
} else {
    if @status == "duplicate" {
        alert("这笔 TNG 交易已导入过，没有重复新增。", "JSave")
    } else {
        alert("JSave 没有确认保存，请检查网络与密钥。", "未完成")
    }
}
